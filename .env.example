# Optional direct Gemini API key for cloud Voice Entry & Receipt Scan parsing (set via AI Studio Secrets panel).
# Voice Entry and Receipt Scan are decoupled from Firebase/App Check and fall back smoothly to on-device ML Kit OCR & local Bangla/English parsing if unset or offline.
GEMINI_API_KEY=UNSET

# Optional external market data providers (set via AI Studio Secrets panel)
# CURRENCY_API_PROVIDER supports: AUTO, OPEN_EXCHANGE_RATES, CURRENCY_FREAKS, EXCHANGE_RATE_API, FRANKFURTER
CURRENCY_API_PROVIDER=AUTO
CURRENCY_API_KEY=UNSET

# GOLD_API_PROVIDER supports: AUTO, GOLD_API_IO, FAST_FOREX
GOLD_API_PROVIDER=AUTO
GOLD_API_KEY=UNSET

