# Firebase AI Logic uses App Check attestation and google-services.json.
# No client-side GEMINI_API_KEY is required.

# Optional external market data providers (set via AI Studio Secrets panel)
# CURRENCY_API_PROVIDER supports: AUTO, OPEN_EXCHANGE_RATES, CURRENCY_FREAKS, EXCHANGE_RATE_API, FRANKFURTER
CURRENCY_API_PROVIDER=AUTO
CURRENCY_API_KEY=UNSET

# GOLD_API_PROVIDER supports: AUTO, GOLD_API_IO, FAST_FOREX
GOLD_API_PROVIDER=AUTO
GOLD_API_KEY=UNSET

